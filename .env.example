# Copy to .env and fill in your real key. .env is gitignored — never commit it.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed for the voiceover feature (src/agents/voice.py) — the rest
# of the app works fine without it.
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed for the optional AI-generated poster background
# (src/poster_background.py) — the poster generator works fine without
# it, falling back to the built-in gradient background.
BFL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
